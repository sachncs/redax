# Copy to .env before running Docker Compose:
#   cp .env.example .env
# Replace the development placeholders with generated values for any shared
# machine. Never commit .env or use these values for a public deployment.

REDAX_ENV=dev
REDAX_LOG_LEVEL=INFO
REDAX_SERVICE_NAME=redax-local
REDAX_REDIS_REQUIRED=true
REDAX_REDIS_NAMESPACE=redax-local
REDAX_DETECTOR=gliner2
REDAX_API_PORT=8000

# The Compose file overrides REDAX_REDIS_URL with the internal redis service.
REDAX_REDIS_URL=redis://redis:6379/0
REDAX_MODEL_CACHE=/models
REDAX_AUDIT_PATH=/var/lib/redax/audit.jsonl
REDAX_POLICIES_DIR=/policies
REDAX_TRUSTED_HOSTS=localhost,127.0.0.1

# Generate local-only values instead of sharing these examples:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
REDAX_HASH_SALT=replace-with-a-local-random-hash-salt
REDAX_API_KEYS=replace-with-a-local-api-key
REDAX_JOB_PAYLOAD_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Set this in a later observability phase once the collector is enabled:
# REDAX_OTLP_ENDPOINT=http://otel-collector:4317
