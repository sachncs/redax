---
import { FOOTER, SITE } from "~/content/site";
const year = new Date().getFullYear();
---
<footer class="relative mt-20">
  <div class="container-x">
    <div class="hairline"></div>
  </div>

  <div class="container-x py-14 sm:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <a href="/redax/" class="inline-flex items-center gap-2.5">
          <span class="grid place-items-center w-7 h-7 rounded-[8px] bg-flame-500">
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 5h7a4 4 0 0 1 4 4v0a4 4 0 0 1-4 4H8"/>
              <path d="M8 13l4 6"/>
              <line x1="4" y1="20" x2="20" y2="20"/>
            </svg>
          </span>
          <span class="font-display text-[16px] font-semibold tracking-tight text-ink-0">redax</span>
        </a>
        <p class="mt-5 max-w-sm text-[14.5px] text-ink-300 leading-[1.55]">{FOOTER.tagline}</p>

        <div class="mt-7 flex items-center gap-3">
          <a
            href={SITE.repo}
            target="_blank"
            rel="noopener"
            class="grid place-items-center w-9 h-9 rounded-full bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] transition-colors text-ink-200"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-1.93c-3.2.69-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.58.24 2.75.12 3.04.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.15c0 .31.21.66.79.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
            </svg>
          </a>
          <a
            href={SITE.registry}
            target="_blank"
            rel="noopener"
            class="grid place-items-center w-9 h-9 rounded-full bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] transition-colors text-ink-200"
            aria-label="Container registry"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="6" width="18" height="14" rx="2"/>
              <path d="M3 10h18M8 4v4M16 4v4"/>
              <circle cx="12" cy="15" r="2.5"/>
            </svg>
          </a>
          <a
            href={`${SITE.repo}/blob/master/CHANGELOG.md`}
            target="_blank"
            rel="noopener"
            class="grid place-items-center w-9 h-9 rounded-full bg-white/[0.04] border border-white/[0.06] hover:bg-white/[0.08] transition-colors text-ink-200"
            aria-label="Changelog"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 7v5l3 2"/>
            </svg>
          </a>
        </div>
      </div>

      {FOOTER.columns.map((col) => (
        <div class="lg:col-span-2 sm:col-span-1">
          <div class="text-[11px] uppercase tracking-[0.2em] text-ink-400">{col.title}</div>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={"external" in l && l.external ? "_blank" : undefined}
                  rel={"external" in l && l.external ? "noopener" : undefined}
                  class="text-[13.5px] text-ink-300 hover:text-ink-0 transition-colors"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="lg:col-span-1 sm:col-span-2 lg:text-right">
        <div class="text-[11px] uppercase tracking-[0.2em] text-ink-400">Status</div>
        <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/[0.04] border border-white/[0.06] px-3 py-1.5 text-[12px] font-mono text-ink-200">
          <span class="w-1.5 h-1.5 rounded-full bg-sage-400"></span>
          all systems
        </div>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-white/[0.05] flex flex-wrap items-center justify-between gap-3">
      <div class="text-[12.5px] text-ink-400">
        © {year} sachin · Apache-2.0 · Built for teams that mean it.
      </div>
      <div class="text-[12.5px] font-mono text-ink-500">
        v0.1.0 · <span class="text-ink-300">deterministic · self-hosted · auditable</span>
      </div>
    </div>
  </div>
</footer>
