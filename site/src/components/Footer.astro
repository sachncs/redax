---
import { FOOTER, SITE } from "~/content/site";
const year = new Date().getFullYear();
---
<footer class="rdx-footer"><div class="rdx-shell">
  <div class="rdx-footer-grid">
    <div><a href="/redax/" class="rdx-footer-brand"><span class="rdx-mark">RX</span><span>REDAX</span></a><p>{FOOTER.tagline}</p></div>
    {FOOTER.columns.map((col) => <div><div class="rdx-footer-label">{col.title}</div><ul>{col.links.map((link) => <li><a class="rdx-footer-link" href={link.href} target={"external" in link && link.external ? "_blank" : undefined} rel={"external" in link && link.external ? "noopener" : undefined}>{link.label}</a></li>)}</ul></div>)}
    <div><div class="rdx-footer-label">STATUS</div><div class="rdx-status-badge">● SELF-HOSTED BOUNDARY</div></div>
  </div>
  <div class="rdx-footer-bottom"><span>© {year} sachin · Apache-2.0 · Built for teams that mean it.</span><span>v{SITE.version} · self-hosted · auditable</span></div>
</div></footer>
