<section id="how-it-works" class="section relative overflow-hidden">
  <div class="container-x">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <span class="pill"><span class="dot"></span>How it works</span>
        <h2 class="reveal mt-5 text-[clamp(36px,5vw,64px)] leading-[1.02] tracking-[-0.04em]">
          Put one safe step between your app and the model.
        </h2>
        <p class="reveal reveal-delay-1 mt-6 max-w-md text-[17px] leading-[1.6] text-ink-300">
          Redax is a boundary, not a black box. Your application sends text in,
          Redax makes the sensitive parts safe, and only the redacted text continues
          to your LLM provider.
        </p>
        <a href="/redax/docs/integration" class="btn-ghost mt-8">
          See the integration guide
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <ol class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-3">
        {[
          { n: "01", title: "Install locally", body: "Run Redax beside your app with Docker Compose. No account, cloud gateway, or data migration." },
          { n: "02", title: "Redact the request", body: "POST your text to /v1/redact. Structured PII and contextual entities become typed placeholders." },
          { n: "03", title: "Call your model", body: "Send only the safe text to your existing LLM. Keep your provider, prompts, and application flow." },
          { n: "04", title: "Audit the boundary", body: "Get spans, a keyed digest, latency, and redaction metadata without putting original values in the audit event." },
        ].map((step, i) => (
          <li class={`reveal reveal-delay-${i + 1} card p-6 ${i % 2 === 1 ? "sm:translate-y-5" : ""}`}>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[11px] tracking-[0.2em] text-flame-300">{step.n}</span>
              <span class="h-px w-10 bg-white/10"></span>
            </div>
            <h3 class="mt-7 text-[19px] font-semibold tracking-[-0.02em] text-ink-0">{step.title}</h3>
            <p class="mt-2.5 text-[14px] leading-[1.6] text-ink-300">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="reveal mt-14 grid grid-cols-1 md:grid-cols-2 gap-px overflow-hidden rounded-[20px] border border-white/[0.08] bg-white/[0.08]">
      <div class="bg-ink-950 p-6 sm:p-8">
        <div class="text-[11px] uppercase tracking-[0.2em] text-sage-400">What your model receives</div>
        <p class="mt-4 font-mono text-[14px] leading-[1.8] text-ink-100">"Hi, I'm [PERSON_0000] from [ORG_0000]."</p>
        <p class="mt-3 text-[13.5px] leading-[1.55] text-ink-400">Transformed text ready for the next system.</p>
      </div>
      <div class="bg-ink-900 p-6 sm:p-8">
        <div class="text-[11px] uppercase tracking-[0.2em] text-flame-300">What stays inside the boundary you control</div>
        <p class="mt-4 font-mono text-[14px] leading-[1.8] text-ink-100">jordan@stripe.com · +1 (415) 555-2671</p>
        <p class="mt-3 text-[13.5px] leading-[1.55] text-ink-400">Raw values stay within the boundary you operate when model files and telemetry egress are controlled.</p>
      </div>
    </div>
  </div>
</section>
