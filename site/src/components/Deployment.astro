---
import { DEPLOY } from "~/content/site";
---
<section id="deploy" class="section relative">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <span class="pill mx-auto"><span class="dot"></span>Deployment</span>
      <h2 class="reveal mt-5 text-[clamp(36px,5vw,64px)] leading-[1.02] tracking-[-0.04em]">
        Pick the runway that fits the team.
      </h2>
      <p class="reveal reveal-delay-1 mt-5 text-[17px] text-ink-300">
        One Docker image. One Python package. One WASM bundle.
        Every path lands on the same API contract.
      </p>
    </div>

    <ul class="reveal mt-14 grid grid-cols-1 md:grid-cols-2 gap-4">
      {DEPLOY.map((d, i) => (
        <li class={`card p-6 sm:p-7 lift relative overflow-hidden ${i === 3 ? "md:col-span-2" : ""}`}>
          <div
            aria-hidden="true"
            class="absolute -top-20 -right-20 w-60 h-60 rounded-full bg-flame-500/10 blur-3xl opacity-50"
          ></div>
          <div class="relative flex items-start justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="pill !text-[10.5px] !font-mono !text-flame-200 !bg-flame-500/10 !border-flame-400/30">
                  {d.badge}
                </span>
                <h3 class="text-[20px] font-semibold tracking-[-0.02em] text-ink-0">{d.title}</h3>
              </div>
              <p class="mt-3 text-[14.5px] leading-[1.55] text-ink-300 max-w-md">{d.body}</p>
            </div>
          </div>
          <pre class="relative mt-5 p-4 sm:p-5 rounded-xl bg-ink-1000/60 border border-white/[0.05] overflow-x-auto text-[12.5px] leading-[1.7] font-mono text-ink-100"><code>{d.code.join("\n")}</code></pre>
        </li>
      ))}
    </ul>
  </div>
</section>
