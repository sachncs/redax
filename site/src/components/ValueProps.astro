---
import { VALUE_PROPS } from "~/content/site";
---
<section id="product" class="section relative">
  <div class="container-x">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <span class="pill"><span class="dot"></span>Product</span>
        <h2 class="reveal mt-5 text-[clamp(36px,5vw,64px)] leading-[1.02] tracking-[-0.04em]">
          Privacy as an architecture,
          not a feature flag.
        </h2>
        <p class="reveal reveal-delay-1 mt-6 text-[17px] text-ink-300 max-w-md">
          Most "PII tools" are regex libraries bolted onto an LLM SDK. Redax is a small,
          explicit service built for the boring, hard part: making transformation behavior,
          operational metadata, and deployment boundaries explainable.
        </p>
      </div>
      <div class="lg:col-span-7">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {VALUE_PROPS.map((v, i) => (
            <li
              class={`reveal reveal-delay-${i % 4} lift card p-6 relative overflow-hidden group`}
            >
              <div
                aria-hidden="true"
                class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-flame-500/0 group-hover:bg-flame-500/10 blur-3xl transition-colors duration-500"
              ></div>
              <div class="relative">
                <div class="font-mono text-[11px] tracking-[0.2em] text-flame-300">{v.eyebrow}</div>
                <h3 class="mt-3 text-[20px] font-semibold tracking-[-0.02em] text-ink-0">{v.title}</h3>
                <p class="mt-2.5 text-[14.5px] leading-[1.55] text-ink-300">{v.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
