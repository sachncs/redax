---
import { NAV, SITE } from "~/content/site";
---
<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-40 transition-[background,backdrop-filter,border-color] duration-300"
  data-state="top"
>
  <div class="container-x">
    <div
      class="mt-3 flex items-center justify-between gap-6 rounded-full border border-transparent px-3 py-2 transition-all duration-300"
      data-shell
    >
      <a href="/redax/" class="flex items-center gap-2.5 pl-1.5 pr-2 py-1 rounded-full">
        <span class="grid place-items-center w-7 h-7 rounded-[8px] bg-flame-500 shadow-[0_4px_18px_-4px_rgb(224_51_78/0.7)]">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 5h7a4 4 0 0 1 4 4v0a4 4 0 0 1-4 4H8"/>
            <path d="M8 13l4 6"/>
            <line x1="4" y1="20" x2="20" y2="20"/>
          </svg>
        </span>
        <span class="font-display text-[15px] font-semibold tracking-tight text-ink-0">redax</span>
        <span class="pill !py-0.5 !px-2 !text-[10px] !font-mono !text-ink-300 hide-mobile">
          <span class="dot"></span>
          v0.1.0
        </span>
      </a>

      <nav class="hide-mobile flex items-center gap-1">
        {NAV.map((item) => (
          <a
            href={item.href}
            class="px-3 py-1.5 rounded-full text-[13px] font-medium text-ink-200 hover:text-ink-0 hover:bg-white/[0.05] transition-colors"
            target={"external" in item && item.external ? "_blank" : undefined}
            rel={"external" in item && item.external ? "noopener" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={SITE.repo}
          target="_blank"
          rel="noopener"
          class="btn-ghost !py-1.5 !px-3 !text-[12.5px] hide-mobile"
          aria-label="View on GitHub"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-1.93c-3.2.69-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.58.24 2.75.12 3.04.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.15c0 .31.21.66.79.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          <span>Star</span>
        </a>
        <a href="#start" class="btn-primary !py-1.5 !px-3 !text-[12.5px]">
          Get started
          <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById("site-nav");
    const shell = nav?.querySelector("[data-shell]");
    if (!nav || !shell) return;

    function onScroll() {
      const y = window.scrollY;
      const next = y > 8 ? "scrolled" : "top";
      if (next === nav.dataset.state) return;
      nav.dataset.state = next;
      if (next === "scrolled") {
        shell.classList.add("glass", "border-white/10");
        shell.classList.remove("border-transparent");
      } else {
        shell.classList.remove("glass", "border-white/10");
        shell.classList.add("border-transparent");
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
