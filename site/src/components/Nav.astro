---
import { NAV, SITE } from "~/content/site";
---
<header id="site-nav" class="rdx-nav" data-state="top">
  <div class="rdx-shell rdx-nav-inner" data-shell>
    <a href="/redax/" class="rdx-brand"><span class="rdx-mark">RX</span><span>REDAX</span><small>v{SITE.version}</small></a>
    <nav aria-label="Primary">
      {NAV.filter((item) => ["Product", "Live demo", "Pipeline", "Docs"].includes(item.label)).map((item) => <a class="rdx-nav-link" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="rdx-nav-actions"><a href={SITE.repo} class="rdx-nav-github" target="_blank" rel="noopener">GitHub ↗</a><a href="#start" class="rdx-button rdx-button-primary">Get started <span>↘</span></a></div>
  </div>
</header>
<script is:inline>
  const nav = document.getElementById("site-nav");
  const shell = nav?.querySelector("[data-shell]");
  function onScroll() { if (!nav || !shell) return; const scrolled = window.scrollY > 8; nav.dataset.state = scrolled ? "scrolled" : "top"; shell.classList.toggle("is-scrolled", scrolled); }
  window.addEventListener("scroll", onScroll, { passive: true }); onScroll();
</script>
