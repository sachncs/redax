---
import Base from "~/layouts/Base.astro";

interface Props {
  title: string;
  description: string;
  active: string;
}

const { title, description, active } = Astro.props;
const links = [
  { key: "index", label: "Overview", href: "/redax/docs/" },
  { key: "api", label: "HTTP API", href: "/redax/docs/api" },
  { key: "architecture", label: "Architecture", href: "/redax/docs/architecture" },
  { key: "integration", label: "Integration", href: "/redax/docs/integration" },
  { key: "policies", label: "Policies", href: "/redax/docs/policies" },
  { key: "bench", label: "Benchmarks", href: "/redax/docs/bench" },
  { key: "deployment", label: "Deployment", href: "/redax/docs/deployment" },
  { key: "production", label: "Production config", href: "/redax/docs/production" },
  { key: "config", label: "Config reference", href: "/redax/docs/config" },
  { key: "security", label: "Security boundary", href: "/redax/docs/security" },
  { key: "data-flow", label: "Data flow", href: "/redax/docs/data-flow" },
  { key: "status", label: "Capability status", href: "/redax/docs/status" },
  { key: "launch", label: "Production launch", href: "/redax/docs/launch" },
];
const activeIndex = links.findIndex((link) => link.key === active);
const previous = activeIndex > 0 ? links[activeIndex - 1] : null;
const next = activeIndex >= 0 && activeIndex < links.length - 1 ? links[activeIndex + 1] : null;
---
<Base title={`${title} · Redax docs`} description={description}>
  <section class="rdx-docs"><div class="rdx-shell rdx-docs-layout">
    <aside class="rdx-docs-sidebar">
      <a href="/redax/" class="rdx-docs-back">← Back to Redax</a>
      <div class="rdx-docs-label">DOCUMENTATION</div>
      <nav aria-label="Documentation" class="rdx-docs-nav">
        {links.map((link) => <a href={link.href} aria-current={active === link.key ? "page" : undefined} class:list={{ active: active === link.key }}>{link.label}</a>)}
      </nav>
      <div class="rdx-docs-start"><div class="rdx-docs-label">START HERE</div><p>Run Redax locally, send one request, and inspect the safe output.</p><a href="/redax/#start">Open quickstart →</a></div>
    </aside>
    <article class="rdx-docs-content">
      <div class="rdx-docs-breadcrumb"><a href="/redax/docs/">Docs</a><span>/</span><span>{title}</span></div>
      <div class="rdx-docs-kicker">REDAX / {active.toUpperCase()}</div>
      <h1>{title}</h1>
      <p class="rdx-docs-lead">{description}</p>
      <div class="rdx-docs-primer"><div><b>WHY</b><span>Keep raw customer text outside the model boundary.</span></div><div><b>WHAT</b><span>A local API that detects, replaces, and records safely.</span></div><div><b>HOW</b><span>Run it, send text, pass only returned text onward.</span></div></div>
      <div class="rdx-docs-body"><slot /></div>
      <nav class="rdx-docs-pager" aria-label="Documentation pagination">
        {previous ? <a href={previous.href}><small>PREVIOUS</small><b>← {previous.label}</b></a> : <span></span>}
        {next ? <a href={next.href}><small>NEXT</small><b>{next.label} →</b></a> : <span></span>}
      </nav>
    </article>
  </div></section>
</Base>

<script is:inline>
  document.querySelectorAll(".rdx-docs-body pre").forEach((block) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "rdx-copy-code";
    button.textContent = "COPY";
    button.addEventListener("click", async () => {
      const code = block.querySelector("code")?.textContent ?? block.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = "COPIED";
      } catch {
        button.textContent = "SELECT MANUALLY";
      }
      window.setTimeout(() => { button.textContent = "COPY"; }, 1800);
    });
    block.append(button);
  });
</script>
